{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./library.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "incremental": true,
    "rootDir": "${configDir}",
    "tsBuildInfoFile": "${configDir}/node_modules/.tmp/tsconfig.test.tsbuildinfo"
  },
  "include": ["${configDir}/src", "${configDir}/*.ts"],
  "exclude": []
}
