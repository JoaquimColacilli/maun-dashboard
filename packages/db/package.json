{
  "name": "@maun/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@maun/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "gen:types": "node scripts/gen-tipos.ts",
    "sb": "node scripts/supabase.ts",
    "db:ca": "node scripts/ca.ts",
    "db:ensayo": "node --conditions=@maun/source scripts/ensayo.ts",
    "db:esquema": "node scripts/esquema.ts",
    "db:medir": "node scripts/medir.ts",
    "db:seed": "node scripts/seed.ts",
    "db:seed:borrar": "node scripts/seed.ts --borrar"
  },
  "dependencies": {
    "@supabase/supabase-js": "catalog:"
  },
  "devDependencies": {
    "@maun/config": "workspace:*",
    "@maun/domain": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "eslint": "catalog:",
    "pg": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
