# Copiar a apps/web/.env y completar.
# Todo lo que empieza con VITE_ termina en el bundle del navegador: acá solo van valores públicos.
# La secret key (sb_secret_...) y la service_role no van ni acá ni en ninguna variable VITE_.

# No hay stack local (ADR 0008): la URL y la key son las del proyecto, en Project Settings > API.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...).
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cuenta de prueba que usa Playwright para entrar una sola vez y guardar la sesión.
# Va SIN prefijo VITE_ a propósito: todo lo que empieza con VITE_ termina en el bundle que se baja
# el navegador, y estas credenciales solo las lee Node desde process.env. Creala en Supabase con
# auto-confirmar: tiene su propio taller y los tests lo vacían antes de cada corrida.
E2E_EMAIL=
E2E_PASSWORD=
