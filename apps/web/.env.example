# Copiar a apps/web/.env y completar.
# Todo lo que empieza con VITE_ termina en el bundle del navegador: acá solo van valores públicos.
# La secret key (sb_secret_...) y la service_role no van ni acá ni en ninguna variable VITE_.

# Local: la URL que imprime `supabase start`. Producción: Project Settings > API.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Publishable key (sb_publishable_...). Local: `supabase status`.
VITE_SUPABASE_PUBLISHABLE_KEY=
