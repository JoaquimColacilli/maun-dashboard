{
  "name": "@maun/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:version": "playwright test --config playwright.version.config.ts",
    "e2e:reparto": "playwright test --config playwright.reparto.config.ts",
    "e2e:transiciones": "playwright test --config playwright.transiciones.config.ts",
    "iconos": "node --conditions=@maun/source scripts/iconos.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "catalog:",
    "@maun/db": "workspace:*",
    "@maun/domain": "workspace:*",
    "@maun/ui": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-persist-client": "catalog:",
    "downshift": "catalog:",
    "idb-keyval": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "react-router": "catalog:",
    "uqr": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@maun/config": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "fake-indexeddb": "catalog:",
    "jsdom": "catalog:",
    "jsqr": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-pwa": "catalog:",
    "vitest": "catalog:",
    "workbox-precaching": "catalog:",
    "workbox-routing": "catalog:",
    "workbox-window": "catalog:"
  }
