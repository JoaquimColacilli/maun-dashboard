{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_PUBLISHABLE_KEY"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {},
    "e2e": {
      "dependsOn": ["^build"],
      "outputs": ["playwright-report/**", "test-results/**"],
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_PUBLISHABLE_KEY", "E2E_EMAIL", "E2E_PASSWORD"],
      "passThroughEnv": ["CI"]
    },
    "e2e:version": {
      "dependsOn": ["^build"],
      "outputs": [],
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_PUBLISHABLE_KEY", "E2E_EMAIL", "E2E_PASSWORD"],
      "passThroughEnv": ["CI"]
    },
    "e2e:reparto": {
      "dependsOn": ["build", "e2e:version"],
      "outputs": [],
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_PUBLISHABLE_KEY", "E2E_EMAIL", "E2E_PASSWORD"],
      "passThroughEnv": ["CI"]
    },
    "e2e:transiciones": {
      "dependsOn": ["build", "e2e:reparto"],
      "outputs": [],
      "env": ["VITE_SUPABASE_URL", "VITE_SUPABASE_PUBLISHABLE_KEY", "E2E_EMAIL", "E2E_PASSWORD"],
      "passThroughEnv": [
        "CI",
        "CAPTURAS_DE_TRANSICIONES",
        "MEDIR_EL_RENDIMIENTO",
        "GRABAR_EL_VIDEO",
        "VIDEOS_DE_TRANSICIONES"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
